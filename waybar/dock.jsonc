// ~/dotfiles/waybar/dock.jsonc
//
// GENERADO por ~/dotfiles/hypr/scripts/gen-dock.py — NO EDITAR A MANO:
// cualquier cambio se pierde la proxima vez que se anada o quite una app.
//
// Las apps se editan en ~/dotfiles/waybar/dock-apps.json, o con el clic
// derecho sobre cualquier icono del dock, que abre el gestor.
//
// El aspecto (colores, tamano de la pastilla, redondeo) esta en el bloque
// "El dock" de style.css, que si es de escritura a mano.
{
    // "name" define tambien el namespace Wayland de la capa. El demonio de
    // auto-ocultado y los layerrules distinguen las cuatro barras por aqui.
    "name": "waybar-dock",
    "layer": "top",
    "position": "bottom",

    // Alto y ancho salen de la cuenta de GEOMETRIA en gen-dock.py:
    // 8 apps x 82 px de celda. Fijar el ancho es lo que hace que
    // waybar centre la barra; el resto del borde inferior queda libre para
    // clickar en tus ventanas.
    "height": 88,
    "width": 656,
    "spacing": 0,

    // Sin zona exclusiva: el dock nunca le quita sitio a las ventanas, sube
    // por encima de ellas.
    "exclusive": false,

    // SIGUSR1 se queda con su valor por defecto (toggle), como en las otras
    // barras: la accion hide de waybar no desmapea la superficie.
    "on-sigusr2": "noop",

    "modules-center": [
        "custom/app1",
        "custom/app2",
        "custom/app3",
        "custom/app4",
        "custom/app5",
        "custom/app6",
        "custom/app7",
        "custom/app8"
    ],

    // Terminal — kitty
    "custom/app1": {
        "format": " ",
        "tooltip-format": "Terminal — kitty",
        "on-click": "uwsm app -- kitty",
        "on-click-right": "$HOME/dotfiles/hypr/scripts/dock-manager.py app1"
    },
    // Archivos — Dolphin
    "custom/app2": {
        "format": " ",
        "tooltip-format": "Archivos — Dolphin",
        "on-click": "uwsm app -- dolphin",
        "on-click-right": "$HOME/dotfiles/hypr/scripts/dock-manager.py app2"
    },
    // Editor de texto
    "custom/app3": {
        "format": " ",
        "tooltip-format": "Editor de texto",
        "on-click": "uwsm app -- gnome-text-editor",
        "on-click-right": "$HOME/dotfiles/hypr/scripts/dock-manager.py app3"
    },
    // Steam
    "custom/app4": {
        "format": " ",
        "tooltip-format": "Steam",
        "on-click": "uwsm app -- steam",
        "on-click-right": "$HOME/dotfiles/hypr/scripts/dock-manager.py app4"
    },
    // AI Limit
    "custom/app5": {
        "format": " ",
        "tooltip-format": "AI Limit",
        "on-click": "uwsm app -- steam steam://rungameid/2407270",
        "on-click-right": "$HOME/dotfiles/hypr/scripts/dock-manager.py app5"
    },
    // Brave
    "custom/app6": {
        "format": " ",
        "tooltip-format": "Brave",
        "on-click": "uwsm app -- brave",
        "on-click-right": "$HOME/dotfiles/hypr/scripts/dock-manager.py app6"
    },
    // ELDEN RING
    "custom/app7": {
        "format": " ",
        "tooltip-format": "ELDEN RING",
        "on-click": "uwsm app -- steam steam://rungameid/1245620",
        "on-click-right": "$HOME/dotfiles/hypr/scripts/dock-manager.py app7"
    },
    // CeliuzPaper
    "custom/app8": {
        "format": " ",
        "tooltip-format": "CeliuzPaper",
        "on-click": "uwsm app -- /home/celiuz/dotfiles/celiuzpaper/celiuzpaper.py",
        "on-click-right": "$HOME/dotfiles/hypr/scripts/dock-manager.py app8"
    }
}
