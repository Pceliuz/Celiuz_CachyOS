// ~/dotfiles/waybar/config.jsonc
// Barra de estado. El estilo (colores, tamanos, espaciado) va en style.css.
// Doc de modulos: https://github.com/Alexays/Waybar/wiki/Configuration

{
    // "name" define tambien el namespace Wayland de la capa, que es como
    // conf/windowrules.conf la distingue del tirador para animarla al ocultarse.
    "name": "waybar-main",

    "layer": "top",
    "position": "top",
    // Sube junto con los iconos: si la barra queda mas baja que el contenido,
    // GTK recorta las pastillas de hover por arriba y por abajo.
    "height": 38,
    "spacing": 0,

    // Clave para el auto-ocultado: sin zona exclusiva la barra nunca le quita
    // espacio a las ventanas. Cuando baja, lo hace ENCIMA de la app: la ventana
    // no se achica ni se recoloca.
    "exclusive": false,

    // SIGUSR1 se deja en su valor por defecto ("toggle") A PROPOSITO.
    // La accion "hide" de waybar no destruye la superficie: solo la baja a la
    // capa inferior, y entonces Hyprland no tiene ningun evento que animar.
    // "toggle" si la desmapea, que es lo que dispara el deslizado del layerrule.
    // El demonio lleva la cuenta del estado, asi que alternar no lo desincroniza.
    "on-sigusr2": "noop",

    // Los sensores van todos juntos a la izquierda, agrupados por componente:
    // primero la CPU (temperatura y uso), luego la memoria (RAM y swap) y al
    // final la GPU (temperatura y uso).
    "modules-left": ["network#velocidad", "temperature", "cpu", "memory", "hyprland/submap"],
    // El reloj va pegado a la izquierda de los workspaces, y el conjunto de los
    // dos es lo que queda centrado en la pantalla.
    "modules-center": ["clock", "hyprland/workspaces"],
    // "modules-right" NO se define aqui, y es la unica lista que falta: vive en
    // los dos ficheros del "include" de abajo, porque su contenido depende de si
    // esto es un portatil (lleva bateria) o un sobremesa (no la lleva).
    //
    // En waybar gana el PRIMERO que define una clave: el fichero que incluye
    // antes que el incluido, y el primer include antes que el segundo. Por eso
    // esta clave no puede estar aqui — si estuviera, ganaria siempre y el
    // generado no pintaria nada.
    //
    // Lo mismo vale para "temperature", que tampoco se define aqui: la ruta del
    // sensor de la CPU depende del procesador de la caja.
    //
    //   local.jsonc    lo escribe instalar.sh segun scripts/lib/maquina.py (la
    //                  bateria) y scripts/lib/sensores.py (la ruta del sensor).
    //                  No se versiona: es de esta maquina y de ninguna otra.
    //   derecha.jsonc  la lista sin bateria, versionada. Es la de un sobremesa
    //                  y ademas la red de seguridad de quien clone el repo y
    //                  arranque waybar antes de pasar el instalador.
    //   sensores.jsonc el modulo de temperatura sin la ruta del sensor. Misma
    //                  red de seguridad: sin ella waybar cae a thermal_zone0.
    //
    // Que falte un include NO es fatal: waybar avisa y sigue (comprobado; ojo,
    // que fuzzel en este mismo repo hace lo contrario y sale con 1). Por eso los
    // dos versionados bastan para que la barra nunca se quede coja.
    "include": [
        "~/.config/waybar/local.jsonc",
        "~/.config/waybar/derecha.jsonc",
        "~/.config/waybar/sensores.jsonc"
    ],
    // El `~` se expande, pero `$HOME` NO: waybar buscaria un directorio llamado
    // literalmente "$HOME" y solo dejaria un aviso en el log. Comprobado.

    // --- CENTRO --- (el bloque "clock" esta al final del archivo)

    "hyprland/workspaces": {
        // Muestra siempre 1-7 aunque esten vacios (coinciden con tus binds SUPER+1..7).
        "persistent-workspaces": { "*": 7 },
        "on-click": "activate",
        // Rueda del mouse sobre la barra para saltar de workspace.
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1"
    },

    // --- IZQUIERDA ---

    "hyprland/submap": {
        // Aparece solo cuando entres a un submap (ej. modo resize). Vacio por ahora.
        "format": " {}",
        "tooltip": false
    },

    // --- IZQUIERDA: sensores ---

    // "temperature" NO se define aqui, igual que "modules-right": sale de los
    // ficheros del "include" de arriba. La razon es que la RUTA DEL SENSOR
    // cambia con el procesador —k10temp en AMD, coretemp en Intel, y colgando
    // cada uno de un sitio distinto del /sys—, asi que la pone instalar.sh en
    // local.jsonc preguntandole a scripts/lib/sensores.py. Lo que se ve
    // (formato, iconos, umbral) esta en waybar/sensores.jsonc, versionado.
    //
    // Aqui estuvo escrita a mano la del Ryzen del autor, y en cualquier otra
    // maquina —incluido su propio portatil— no existia y el modulo se quedaba
    // sin poder leer nada.

    "cpu": {
        // {usage} ES el uso total del procesador: la media de los 12 hilos del
        // Ryzen 5 5500, el mismo numero que da el "CPU" de btop. No es el de un
        // proceso suelto. El desglose por hilo esta en el tooltip.
        "format": "<span size='130%'>󰻠</span> {usage}%",
        "interval": 2,
        "tooltip-format": "Uso total: {usage}%\nCarga (1/5/15 min): {load}\nFrecuencia media: {avg_frequency} GHz",
        "on-click": "$HOME/.config/hypr/scripts/terminal.sh monitor-tui btop"
    },

    "memory": {
        "format": "<span size='130%'>󰍛</span> {percentage}%",
        "interval": 2,
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G",
        "on-click": "$HOME/.config/hypr/scripts/terminal.sh monitor-tui btop"
    },



    // --- DERECHA ---

    "pulseaudio": {
        // Funciona con PipeWire via pipewire-pulse (lo que tienes instalado).
        "format": "<span size='130%'>{icon}</span> {volume}%",
        "format-muted": "<span size='130%'>󰝟</span> muteado",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{desc} — {volume}%"
    },

    // --- IZQUIERDA: velocidad de internet ---
    // Segunda instancia del modulo `network`. Waybar permite varias del mismo
    // modulo con la sintaxis modulo#alias; la de la derecha ensena la IP y esta
    // el trafico. Comparten el mismo codigo, asi que no cuesta nada mas.
    //
    // NO se fija `interface` a proposito: waybar coge sola la de la ruta por
    // defecto. Ahora mismo es un adaptador USB (enp22s0f0u1), y si algun dia
    // pasas a wifi o cambias de cable esto sigue funcionando sin tocarlo.
    "network#velocidad": {
        // Los glifos van como escapes \uXXXX y NO como caracteres sueltos: son
        // del rango de Uso Privado de la Nerd Font, y escritos tal cual se
        // corrompen al pasar por herramientas de texto (ya paso dos veces en
        // este repo). Asi el archivo es ASCII puro y no hay nada que se pueda
        // aplastar. \uf063 es la flecha abajo y \uf062 la de arriba.
        "format": "<span size='130%'>\uf063</span> {bandwidthDownBytes}  <span size='130%'>\uf062</span> {bandwidthUpBytes}",
        "format-disconnected": "<span size='130%'>\uf063</span> --  <span size='130%'>\uf062</span> --",
        // 2 s: waybar calcula la velocidad como la media entre dos lecturas, asi
        // que este numero es tambien la ventana de promediado. Menos de eso da
        // cifras que saltan demasiado para leerlas.
        "interval": 2,
        // Los campos bandwidth* YA traen la unidad por segundo ("252.9kB/s"), asi
        // que anadir "/s" aqui daria "kB/s/s".
        "tooltip-format": "{ifname}\nBajada: {bandwidthDownBytes}\nSubida: {bandwidthUpBytes}\nTotal: {bandwidthTotalBytes}",
        "on-click": "$HOME/.config/hypr/scripts/terminal.sh monitor-tui nmtui"
    },

    "network": {
        "format-ethernet": "<span size='130%'>󰈀</span> {ipaddr}",
        "format-wifi": "<span size='130%'>󰤨</span> {essid} {signalStrength}%",
        "format-linked": "<span size='130%'>󰈀</span> sin IP",
        "format-disconnected": "<span size='130%'>󰤭</span> desconectado",
        "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}\n↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname} — IP: {ipaddr}/{cidr}\nGateway: {gwaddr}\n↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "interval": 5,
        // nmtui viene con networkmanager, no hace falta instalar nada extra.
        "on-click": "$HOME/.config/hypr/scripts/terminal.sh monitor-tui nmtui"
    },

    // --- DERECHA: bateria (solo en portatiles) ---
    //
    // El bloque se queda SIEMPRE aqui, tambien en un sobremesa, y no pasa nada:
    // waybar solo instancia los modulos que aparecen en algun "modules-*". Lo
    // que decide si existe o no es la lista del include, no esto. Asi la
    // configuracion del modulo se versiona una sola vez y no hay que duplicarla
    // dentro de un fichero generado.
    //
    // Si acabara colandose en un equipo sin bateria, tampoco seria grave:
    // waybar deja un aviso ("No batteries.") y sigue — no se cae. Pero el hueco
    // vacio se veria en la barra, y por eso se decide por fuera.
    "battery": {
        // Los umbrales dan clase CSS (#battery.atencion, #battery.critico) y es
        // ahi donde style.css pone el color y el parpadeo. Aqui no va ni un
        // color: la paleta manda desde colores.conf.
        //
        // 25 y 10 y no 30/15: por debajo de 30 todavia queda mas de una hora de
        // trabajo y avisar tan pronto ensena a ignorar el aviso.
        "states": { "atencion": 25, "critico": 10 },

        "format": "<span size='130%'>{icon}</span> {capacity}%",

        // Enchufado y subiendo. El rayo es el que se mueve en style.css.
        "format-charging": "<span size='130%'>󰂄</span> {capacity}%",
        // Enchufado y ya lleno: el rayo sobra, deja de cargar.
        "format-full": "<span size='130%'>󰂅</span> {capacity}%",
        // Enchufado pero sin cargar. Pasa de verdad: muchos portatiles paran
        // sobre el 80% para cuidar la bateria, y sin este caso la barra diria
        // "cargando" durante horas sin que suba ni un punto.
        "format-not-charging": "<span size='130%'>󰂄</span> {capacity}%",
        // Descargando y en las ultimas: el icono cambia a la alerta, para que se
        // note aunque no se lea el numero.
        "format-critico": "<span size='130%'>󰂃</span> {capacity}%",

        // De vacia a llena. Waybar elige segun la carga, asi que el orden
        // importa: de menos a mas.
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],

        "format-time": "{H} h {M} min",

        // 15 s y no los 60 de fabrica: al enchufar o desenchufar el cable, un
        // minuto de retraso hace dudar de si el cargador esta bien puesto.
        // Es leer cuatro ficheros de /sys, no cuesta nada.
        "interval": 15,

        // {time} lo calcula waybar con el consumo del ultimo refresco, no con
        // una media: justo despues de abrir algo pesado da cifras raras. Por eso
        // va en el tooltip y no en la barra.
        "tooltip-format": "{capacity}% — quedan {time}\nConsumo ahora: {power} W\nSalud de la bateria: {health}%\nCiclos de carga: {cycles}"
    },

    // --- DERECHA: notificaciones (mako) ---

    "custom/notificaciones": {
        // El script devuelve texto, tooltip y CLASE. El color de cada estado se
        // decide en style.css a partir de esa clase, no aqui: asi los colores
        // siguen viniendo todos de la paleta y no hay ninguno escrito en bash.
        "exec": "$HOME/.config/waybar/scripts/notificaciones.sh",
        "return-type": "json",
        // Cada 2 s. Es un grep sobre la salida de makoctl, no cuesta nada, y
        // mako no avisa por ninguna senal cuando cambia la cuenta.
        "interval": 2,
        "format": "<span size='130%'>{}</span>",
        "on-click": "makoctl dismiss",
        "on-click-right": "makoctl mode -t no-molestar",
        "on-click-middle": "makoctl restore",
        "escape": true
    },

    "tray": {
        // Los iconos del tray son imagenes, no glifos: no les llega el <span>.
        "icon-size": 20,
        "spacing": 8
    },

    "clock": {
        // Se ve "󰥔 26 jul  20:15". Ni clic derecho ni tooltip: el izquierdo
        // abre el panel de calendario y con eso basta.
        //
        // La "L" del formato NO es decorativa: waybar formatea con la libreria
        // fmt, y fmt solo consulta el locale cuando el formato lleva ese
        // especificador. Sin ella el mes sale "Jul" en vez de "jul" por muy
        // bien puesto que este el idioma.
        //
        // Y NO se pone aqui ningun "locale". Antes decia "es_PE.utf8", que en
        // esta laptop no esta generado (`locale -a` solo trae es_MX.utf8);
        // cuando el locale no existe waybar no falla ni avisa: se queda en
        // ingles y el mes sale "Aug". Cablear un pais es ademas lo que este
        // repo no debe hacer, que se usa en mas de un equipo. Sin la opcion,
        // waybar toma el locale de la sesion, y los nombres de mes son iguales
        // en todos los locales de espanol.
        "format": "<span size='130%'>󰥔</span> {:L%d %b  %H:%M}",
        // El calendario ya no vive aqui. El tooltip de waybar solo sabe dibujar
        // una rejilla de numeros: no puede mostrar feriados ni tus eventos de
        // Google, y aparece con solo rozar el reloj. Lo reemplaza el panel de
        // scripts/calendar-panel.py, que se abre con click y se cierra con otro.
        "tooltip": false,
        "on-click": "$HOME/.config/hypr/scripts/calendar-panel.py"
    }
}
