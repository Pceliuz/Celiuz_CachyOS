// fastfetch/config.jsonc — el cuadro con los datos del equipo al abrir una
// terminal. Lo enlaza instalar.sh a ~/.config/fastfetch, asi que un `fastfetch`
// a secas tambien lo usa (con el logo de la distro).
//
// La imagen la pone hypr/scripts/saludo.sh (`celiuz-saludo`): elige una al azar
// de fastfetch/imagenes/ (en el repo) y se la pasa con --logo. Aqui solo va lo que no cambia.
//
// Los colores son los ANSI de la terminal (magenta, blanco...), no un hex: asi
// siguen al tema de kitty de cada equipo. Los iconos son de Nerd Font.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "magenta", "output": "white" },
        "size": { "binaryPrefix": "iec" }
    },
    "modules": [
        "break",
        { "type": "os",       "key": "" },
        { "type": "kernel",   "key": "" },
        { "type": "packages", "key": "" },
        { "type": "shell",    "key": "" },
        { "type": "terminal", "key": "" },
        { "type": "wm",       "key": "" },
        { "type": "display",  "key": "", "compactType": "original-with-refresh-rate" },
        { "type": "cpu",      "key": "", "format": "{name}" },
        { "type": "gpu",      "key": "", "format": "{name}", "hideType": "integrated" },
        { "type": "memory",   "key": "" },
        { "type": "disk",     "key": "", "folders": "/" },
        { "type": "battery",  "key": "" },
        { "type": "uptime",   "key": "" },
        // Los dias desde que se instalo el sistema (la fecha de creacion de /).
        {
            "type": "command",
            "key": "",
            "text": "n=$(stat -c %W /); [ \"$n\" -gt 0 ] && echo \"$(( ($(date +%s) - n) / 86400 )) días\""
        },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
