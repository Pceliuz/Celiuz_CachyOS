// GENERADO por hypr/scripts/gen-colores.py desde fastfetch/plantilla.jsonc
// y hypr/conf/colores.conf — NO EDITAR A MANO: se edita la plantilla.
// fastfetch/plantilla.jsonc — el cuadro con los datos del equipo al abrir una
// terminal. ESTE es el que se edita: hypr/scripts/gen-colores.py lo convierte
// en fastfetch/config.jsonc cambiando cada nombre entre arrobas por ese color de la paleta
// (hypr/conf/colores.conf), en el formato de fastfetch («38;2;R;G;B»). Un
// nombre que no este en la paleta para el generador con un error.
//
// instalar.sh enlaza la carpeta a ~/.config/fastfetch, asi que un `fastfetch`
// a secas tambien lo usa (con el logo de la distro). La imagen, su tamaño y
// donde va los pone hypr/scripts/saludo.sh (`celiuz-saludo`), que mide la
// terminal cada vez.
//
// Los colores (lo pidio el usuario, 2026-10-21): cada icono de un color, en
// rueda — rojo, violeta, azul electrico, azul neon, el violeta de la config
// (amatista) y verde neon — y el texto en $luz. Los puntos de abajo son esos
// seis colores y no los ANSI del tema de kitty, que eran distintos en cada
// equipo. Los iconos son de Nerd Font.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "   ",
        "color": { "output": "38;2;228;199;255" },
        "percent": { "color": { "green": "38;2;57;255;20", "yellow": "38;2;246;193;119", "red": "38;2;255;31;75" } },
        "size": { "binaryPrefix": "iec" }
    },
    "modules": [
        "break",
        { "type": "os",       "key": "", "keyColor": "38;2;255;31;75" },
        { "type": "kernel",   "key": "", "keyColor": "38;2;106;0;244" },
        { "type": "packages", "key": "", "keyColor": "38;2;47;107;255" },
        { "type": "shell",    "key": "", "keyColor": "38;2;0;229;255" },
        { "type": "terminal", "key": "", "keyColor": "38;2;177;108;255" },
        { "type": "wm",       "key": "", "keyColor": "38;2;57;255;20" },
        { "type": "display",  "key": "", "keyColor": "38;2;255;31;75", "compactType": "original-with-refresh-rate" },
        { "type": "cpu",      "key": "", "keyColor": "38;2;106;0;244", "format": "{name}" },
        { "type": "gpu",      "key": "", "keyColor": "38;2;47;107;255", "format": "{name}", "hideType": "integrated" },
        { "type": "memory",   "key": "", "keyColor": "38;2;0;229;255" },
        { "type": "disk",     "key": "", "keyColor": "38;2;177;108;255", "folders": "/" },
        { "type": "battery",  "key": "", "keyColor": "38;2;57;255;20" },
        { "type": "uptime",   "key": "", "keyColor": "38;2;255;31;75" },
        // Los dias desde que se instalo el sistema (la fecha de creacion de /).
        {
            "type": "command",
            "key": "",
            "keyColor": "38;2;106;0;244",
            "text": "n=$(stat -c %W /); [ \"$n\" -gt 0 ] && echo \"$(( ($(date +%s) - n) / 86400 )) días\""
        },
        "break",
        {
            "type": "custom",
            "format": "{#38;2;255;31;75}●  {#38;2;106;0;244}●  {#38;2;47;107;255}●  {#38;2;0;229;255}●  {#38;2;177;108;255}●  {#38;2;57;255;20}●{#}"
        }
    ]
}
